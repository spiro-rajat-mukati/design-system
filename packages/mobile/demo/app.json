{
  "expo": {
    "name": "Kijani Mobile Showcase",
    "slug": "kijani-mobile-demo",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kijani.mobiledemo"
    },
    "android": {
      "package": "com.kijani.mobiledemo",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "scheme": "kijanidemo",
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}
