{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "@figma/code-connect/figma-types"]
  },
  "include": ["src", "vite.config.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "src/**/*.stories.*",
    "src/**/*.figma.tsx",
    "src/**/*.test.*",
    "src/**/*.test.jsx",
    "src/App.jsx",
    "src/main.tsx",
    "src/setupTests.js"
  ]
}
