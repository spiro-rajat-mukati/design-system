{
  "name": "@kijani/web",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/web.css"
  },
  "files": ["dist"],
  "sideEffects": ["**/*.css"],
  "dependencies": {
    "@kijani/tokens": "*",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "scripts": {
    "tokens:build": "node ../tokens/build.mjs",
    "tokens:watch": "node --watch-path=../tokens/source ../tokens/build.mjs",
    "tokens:check": "node ../tokens/check-generated.mjs",
    "predev": "npm run tokens:build",
    "prebuild": "npm run tokens:build",
    "prestorybook": "npm run tokens:build",
    "prebuild-storybook": "npm run tokens:build",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "npx chromatic",
    "chromatic:ci": "npx chromatic --exit-zero-on-changes --exit-once-uploaded",
    "test-storybook": "test-storybook"
  },
  "eslintConfig": {
    "extends": ["plugin:storybook/recommended"]
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/react": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "chromatic": "^16.7.0",
    "eslint-plugin-storybook": "^10.3.6",
    "jsdom": "^29.1.1",
    "prop-types": "^15.8.1",
    "storybook": "^10.3.6",
    "typescript": "^5.3.0",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2",
    "vitest": "^4.1.9"
  }
}
