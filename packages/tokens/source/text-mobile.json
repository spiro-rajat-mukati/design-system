{
  "text": {
    "mobile": {
      "title-xl": {
        "size":   { "$value": "{font-size.800}",        "$type": "fontSizes" },
        "line":   { "$value": "{line-height.tight}",    "$type": "lineHeights" },
        "weight": { "$value": "{font-weight.semibold}", "$type": "fontWeights" }
      },
      "title-lg": {
        "size":   { "$value": "{font-size.650}",        "$type": "fontSizes", "$description": "Sub-heading = 28px (was 30/font-size.700)" },
