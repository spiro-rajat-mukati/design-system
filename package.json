{
  "name": "kijani-design-system",
  "version": "0.1.0",
  "private": true,
  "description": "Kijani design system monorepo — shared token foundation plus the web and mobile component libraries.",
  "workspaces": [
    "packages/*",
    "figma-plugin"
  ],
  "scripts": {
    "tokens:build": "node packages/tokens/build.mjs",
    "tokens:check": "node packages/tokens/check-generated.mjs",
    "icons:build": "node packages/icons/build.mjs",
    "icons:check": "node packages/icons/check-generated.mjs",
    "illustrations:build": "node packages/illustrations/build.mjs",
    "illustrations:check": "node packages/illustrations/check-generated.mjs",
    "plugin:build": "npm run build -w @kijani/figma-plugin",
    "plugin:check": "node figma-plugin/test/check-dist.mjs",
    "plugin:roundtrip": "node figma-plugin/test/check-roundtrip.mjs",
    "start": "npm run start -w @kijani/web",
    "build": "npm run build -w @kijani/web",
    "test": "npm run test -w @kijani/web",
    "storybook": "npm run storybook -w @kijani/web",
    "build-storybook": "npm run build-storybook -w @kijani/web",
    "chromatic": "npm run chromatic -w @kijani/web"
  }
}
